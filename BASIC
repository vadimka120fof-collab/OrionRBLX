do
	-- China Hat
	local function buildHat(folder, head, m, color, layers)
		local sz = m.s.Size / 1.5
		local R, H = 1.9 * sz, 1.15 * sz
		local layerH = H / layers
		local baseY = head.Size.Y / 2 - 0.04
		local mat = m.s.Neon and Enum.Material.Neon or Enum.Material.SmoothPlastic
		local band = m.s["Band Color"]
		local tr = m.s.Transparency
		local bandEvery = math.max(2, math.floor(layers / 5))
		local function mk(shape, size, col, transp, cf)
			local p = new("Part", {
				Shape = shape, Size = size, Material = mat, Color = col,
				Transparency = transp, Anchored = false, CanCollide = false,
				CanQuery = false, CanTouch = false, CastShadow = false, Massless = true,
				TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth,
			}, folder)
			new("Weld", { Part0 = head, Part1 = p, C0 = cf }, p)
			return p
		end
		mk(Enum.PartType.Cylinder, Vector3.new(0.07, R * 2 + 0.12, R * 2 + 0.12), band, math.max(0, tr - 0.15), CFrame.new(0, baseY, 0) * CFrame.Angles(0, 0, math.pi / 2))
		for i = 0, layers - 1 do
			local t = i / (layers - 1)
			local diameter = math.max(R * 2 * (1 - t) ^ 1.12, 0.06)
			local isBand = i > 0 and i % bandEvery == 0
			mk(Enum.PartType.Cylinder, Vector3.new(layerH * 0.999, diameter, diameter), isBand and band or color, isBand and math.max(0, tr - 0.1) or tr, CFrame.new(0, baseY + layerH / 2 + i * layerH, 0) * CFrame.Angles(0, 0, math.pi / 2))
		end
		mk(Enum.PartType.Ball, Vector3.new(0.3 * sz, 0.3 * sz, 0.3 * sz), band, 0.2, CFrame.new(0, baseY + H + 0.08 * sz, 0))
	end

	add("Render", "China Hat", "Конусная шляпа на голове", {
		{ type = "slider", name = "Layers", min = 6, max = 30, step = 1, value = 14 },
		{ type = "slider", name = "Size", min = 0.5, max = 3, step = 0.1, value = 1.5 },
		{ type = "slider", name = "Transparency", min = 0, max = 0.9, step = 0.05, value = 0.1 },
		{ type = "toggle", name = "Neon", value = true },
