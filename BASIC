			Debris:AddItem(folder, dur + 0.2)
			safeSpawn(function()
				local t0 = os.clock()
				while folder.Parent do
					local x = (os.clock() - t0) / dur
					if x >= 1 then break end
					for _, p in ipairs(parts) do
