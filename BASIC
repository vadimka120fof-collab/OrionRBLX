				r.CFrame = CFrame.new(r.Position) * CFrame.Angles(0, math.rad(spinnyBaseYaw + angOff), 0)
			else
				spinnyAngle = (spinnyAngle + 0.05 * m.s["Spin Speed"] * 360) % 360
				r.CFrame = CFrame.new(r.Position) * CFrame.Angles(0, math.rad(spinnyAngle), 0)
			end
			if m.s["Auto Shoot"] and os.clock() - spinnyLastShot >= m.s["Shoot Delay"] then
				spinnyLastShot = os.clock()
				local tool = char() and char():FindFirstChildOfClass("Tool")
				if tool then pcall(function() tool:Activate() end) end
			end
			if m.s["Auto Jump"] and h.FloorMaterial ~= Enum.Material.Air then
				local now = os.clock()
				if not m._lastJump or now - m._lastJump >= m.s["Jump Interval"] then
					m._lastJump = now
					h:ChangeState(Enum.HumanoidStateType.Jumping)
				end
			end
		end,
	})
end

