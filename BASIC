				if not tint then
					tint = Instance.new("ColorCorrectionEffect")
					tint.Name = "Orion_SkyTint"
					tint.Parent = Lighting
				end
			end
		end

		local function apply(m)
			ensure()
			local c = m.s["Color"] or Color3.fromRGB(72, 48, 227)
			local s = m.s["Strength"]
			atmo.Color = c
			atmo.Decay = c
			atmo.Density = m.s["Density"]
			atmo.Haze = m.s["Haze"]
