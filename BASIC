local function add(tab, name, desc, settings, hooks)
	local m = { tab = tab, name = name, desc = desc, on = false, bind = nil, defs = settings or {}, s = {}, hooks = hooks or {}, real = true }
	for _, d in ipairs(m.defs) do
		if d.type == "color2" then m.s[d.name] = d.value1 m.s[d.name .. "_2"] = d.value2
		else m.s[d.name] = d.value end
	end
	table.insert(modules, m) byName[tab .. "/" .. name] = m
	return m
end
local function setModuleOn(m, state)
	if not m or m.on == state then return end
	m.on = state
	if state then if m.hooks.onEnable then safeSpawn(m.hooks.onEnable, m) end
	else if m.hooks.onDisable then safeSpawn(m.hooks.onDisable, m) end end
	if m.refresh then m.refresh() end
end
