	local reloading = false
	local cachedSlots = {}
	local cacheTime = 0
	local lastEquipped = nil

	local function refreshSlotsCache()
		local now = os.clock()
		if now - cacheTime < 0.5 and #cachedSlots > 0 then return cachedSlots end
		local c = char()
		if not c then cachedSlots = {} return cachedSlots end
		local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
		local slots = {}
		if bp then
			for _, t in ipairs(bp:GetChildren()) do
				if t:IsA("Tool") then table.insert(slots, t) end
			end
		end
		for _, t in ipairs(c:GetChildren()) do
			if t:IsA("Tool") then
				local found = false
				for _, s in ipairs(slots) do if s == t then found = true break end end
				if not found then table.insert(slots, t) end
			end
		end
		cachedSlots = slots cacheTime = now
		return slots
	end

	local ammoCache = {}
	local function getAmmo(tool)
		if not tool or not tool.Parent then return nil end
		local entry = ammoCache[tool]
		if entry and os.clock() - entry.t < 0.1 then return entry.v end
		local names = { "Ammo", "AmmoValue", "CurrentAmmo", "Magazine", "Clip", "AmmoCount", "Bullets", "CurrentMag", "MagAmmo" }
		local result = nil
		for _, n in ipairs(names) do
			local v = tool:FindFirstChild(n)
			if v and (v:IsA("IntValue") or v:IsA("NumberValue") or v:IsA("StringValue")) then
				local num = tonumber(v.Value)
				if num then result = num break end
			end
		end
		if result == nil then
			for _, d in ipairs(tool:GetDescendants()) do
				if d:IsA("IntValue") or d:IsA("NumberValue") then
					local n = string.lower(d.Name)
					if string.find(n, "ammo") or string.find(n, "clip") or string.find(n, "mag") or string.find(n, "bullet") then
						local num = tonumber(d.Value)
						if num then result = num break end
					end
				end
			end
		end
		ammoCache[tool] = { v = result, t = os.clock() }
		return result
	end

	local function tryReload(tool)
		if not tool or not tool.Parent then return end
		local c = char() if not c then return end
		local h = c:FindFirstChildOfClass("Humanoid") if not h then return end
		if h:FindFirstChild("Tool") ~= tool then
			pcall(function() h:EquipTool(tool) end)
			task.wait(0.1)
		end
		local reloaded = false
		for _, d in ipairs(tool:GetDescendants()) do
			if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
				local n = string.lower(d.Name)
				if string.find(n, "reload") then
					pcall(function()
						if d:IsA("RemoteEvent") then d:FireServer() else d:InvokeServer() end
					end)
					reloaded = true break
				end
			end
		end
		if not reloaded then
			pcall(function()
				local VIM = game:GetService("VirtualInputManager")
				VIM:SendKeyEvent(true, Enum.KeyCode.R, false, game)
				task.wait(0.05)
				VIM:SendKeyEvent(false, Enum.KeyCode.R, false, game)
			end)
		end
	end

	local function doSwap()
		if not enabled or reloading then return end
		local c = char() if not c then return end
		local h = c:FindFirstChildOfClass("Humanoid") if not h then return end
		local slots = refreshSlotsCache()
		if #slots == 0 then return end
		local idxP, idxS = nil, nil
		for i, tool in ipairs(slots) do
			if tool == gunModData.primary then idxP = i end
			if tool == gunModData.secondary then idxS = i end
		end
		local target
		if currentSlot == "primary" then target = slots[idxP] or slots[idxS]
		else target = slots[idxS] or slots[idxP] end
		if not target then
			if #slots >= 2 then target = (currentSlot == "primary") and slots[2] or slots[1]
			else target = slots[1] end
		end
		if not target then return end
		if lastEquipped == target and h:FindFirstChild("Tool") == target then
			currentSlot = (currentSlot == "primary") and "secondary" or "primary"
			return
		end
		local ammo = getAmmo(target)
		if ammo ~= nil and ammo <= 0 then
			reloading = true
			safeSpawn(function()
				if gunModData.primary then tryReload(gunModData.primary) task.wait(1.0) end
				if gunModData.secondary and gunModData.secondary ~= gunModData.primary then
					tryReload(gunModData.secondary) task.wait(1.0)
				end
				reloading = false
			end)
			return
		end
		if h:FindFirstChild("Tool") ~= target then
			pcall(function() h:EquipTool(target) end)
			lastEquipped = target
		end
		currentSlot = (currentSlot == "primary") and "secondary" or "primary"
	end

	add("Combat", "Gun Mod (Rapid Fire)", "Быстрый свап с проверкой патронов", {
		{ type = "slider", name = "Swap Delay", min = 0.02, max = 0.5, step = 0.01, value = 0.08 },
	}, {
		onEnable = function(mm)
			enabled = true
			swapDelay = mm.s["Swap Delay"]
			currentSlot = "primary" cacheTime = 0
			if swapLoop then swapLoop:Disconnect() end
			local lastSwap = 0
			swapLoop = RunService.Heartbeat:Connect(function()
				if not enabled then return end
				local now = os.clock()
				if now - lastSwap < swapDelay then return end
				lastSwap = now
				pcall(doSwap)
			end)
		end,
		onStep = function(mm) swapDelay = mm.s["Swap Delay"] end,
		onDisable = function()
			enabled = false
			if swapLoop then swapLoop:Disconnect() swapLoop = nil end
		end,
	})
end

