	local function colorToTable(c) return { r = math.floor(c.R*255+0.5), g = math.floor(c.G*255+0.5), b = math.floor(c.B*255+0.5) } end
	local function tableToColor(t)
		if type(t) ~= "table" then return Color3.new(1,1,1) end
		return Color3.fromRGB(t.r or 255, t.g or 255, t.b or 255)
	end
	local function serializeModule(m)
		local entry = { on = m.on, bind = m.bind and m.bind.Name or nil, s = {} }
		for _, d in ipairs(m.defs) do
			local key = d.name
			local val = m.s[key]
			if d.type == "color" or d.type == "color2" then entry.s[key] = colorToTable(val)
			else entry.s[key] = val end
		end
		for _, d in ipairs(m.defs) do
			if d.type == "color2" then
				local key2 = d.name .. "_2"
				entry.s[key2] = colorToTable(m.s[key2])
			end
		end
		return entry
	end
	local function applyModule(m, entry)
		if not entry then return end
		if entry.s then
			for _, d in ipairs(m.defs) do
				local key = d.name
				if entry.s[key] ~= nil then
					if d.type == "color" or d.type == "color2" then m.s[key] = tableToColor(entry.s[key])
					else m.s[key] = entry.s[key] end
				end
				if d.type == "color2" then
					local key2 = d.name .. "_2"
					if entry.s[key2] ~= nil then m.s[key2] = tableToColor(entry.s[key2]) end
				end
			end
		end
		if entry.bind then m.bind = Enum.KeyCode[entry.bind] end
		if entry.on ~= nil then setModuleOn(m, entry.on and true or false) end
		if m.refreshSettings then for _, fn in ipairs(m.refreshSettings) do fn() end end
		if m.refresh then m.refresh() end
	end
