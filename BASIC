		local function getFolders()
			local list = {}
			local rs = game:GetService("ReplicatedStorage")
			local assets = rs:FindFirstChild("Assets")
			local temp = assets and assets:FindFirstChild("Temp")
			local rsVM = temp and temp:FindFirstChild("ViewModels")
			if rsVM then table.insert(list, rsVM) end
			local wsVM = workspace:FindFirstChild("ViewModels")
			if wsVM then
				local fp = wsVM:FindFirstChild("FirstPerson")
				if fp then table.insert(list, fp) end
			end
			return list
		end
		local function isMine(obj)
			if not obj:IsA("Model") then return false end
			return string.find(obj.Name, VM.playerName, 1, true) ~= nil
		end
		local function registerVM(model)
			if VM.models[model] then return end
			VM.models[model] = true
			for _, d in ipairs(model:GetDescendants()) do
				if d:IsA("AlignPosition") or d:IsA("AlignOrientation")
					or d:IsA("BodyPosition") or d:IsA("BodyGyro")
					or d:IsA("BodyVelocity") or d:IsA("BodyAngularVelocity") then
					d.Enabled = false
				end
			end
		end
		local function scanVM()
			local n = 0
			for _, folder in ipairs(getFolders()) do
				for _, obj in ipairs(folder:GetChildren()) do
					if isMine(obj) then registerVM(obj) n = n + 1 end
				end
			end
			return n
		end
		task.spawn(function()
			local rsVM, wsFP
			while not (rsVM and wsFP) do
				for _, f in ipairs(getFolders()) do
					local path = f:GetFullName()
					if path:find("Temp.ViewModels", 1, true) then rsVM = f end
					if path:find("FirstPerson", 1, true) then wsFP = f end
				end
				if not rsVM or not wsFP then task.wait(0.5) end
			end
			scanVM()
			rsVM.ChildAdded:Connect(function(child)
				task.wait(0.05)
				if isMine(child) then registerVM(child) end
			end)
			wsFP.ChildAdded:Connect(function(child)
				task.wait(0.05)
				if isMine(child) then registerVM(child) end
			end)
			while true do
				task.wait(3)
