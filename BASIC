	-- ============================================================
	-- CUSTOM PLAYER MODEL
	-- ============================================================
	do
		local SKIN_ID = 14679634410
		local skinCache = nil
		local skinState = nil
		local skinEnabled = false
		local skinCharConn = nil

		local function scaleOffset(cf, f) return CFrame.new(cf.Position * (f - 1)) * cf end
		local function scaleMeshes(inst, f)
			for _, m in ipairs(inst:GetChildren()) do
				if m:IsA("SpecialMesh") and m.MeshType == Enum.MeshType.FileMesh then
					m.Scale = m.Scale * f
				end
			end
		end
		local function scaleHandle(h, f)
			h.Size = h.Size * f
			scaleMeshes(h, f)
			for _, a in ipairs(h:GetChildren()) do
				if a:IsA("Attachment") then a.Position = a.Position * f end
			end
		end
		local function scaleHead(model, f)
			if not f or f == 1 then return end
			local head = model:FindFirstChild("Head", true)
			if not (head and head:IsA("BasePart")) then return end
			head.Size = head.Size * f
			scaleMeshes(head, f)
			for _, a in ipairs(head:GetChildren()) do
				if a:IsA("Attachment") then a.Position = a.Position * f end
			end
			local done = {}
			local function handleOf(part)
				if part and part.Parent and part.Parent:IsA("Accessory") and not done[part] then
					done[part] = true
					scaleHandle(part, f)
					return true
				end
				return false
			end
			for _, j in ipairs(model:GetDescendants()) do
				if j:IsA("JointInstance") then
					if j.Part1 == head then
						j.C1 = scaleOffset(j.C1, f)
						if handleOf(j.Part0) then j.C0 = scaleOffset(j.C0, f) end
					elseif j.Part0 == head then
						j.C0 = scaleOffset(j.C0, f)
						if handleOf(j.Part1) then j.C1 = scaleOffset(j.C1, f) end
					end
				end
			end
		end
		local function getSkinModel()
			if skinCache and skinCache.Parent then return skinCache end
			local pre = ReplicatedStorage:FindFirstChild("FoxyAssets")
			local ready = pre and pre:FindFirstChild("Skin")
			if ready then skinCache = ready return skinCache end
			local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. SKIN_ID) end)
			if ok and type(objs) == "table" and #objs > 0 then
				local holder = Instance.new("Folder")
				holder.Name = "FoxySkinHolder"
				for _, o in ipairs(objs) do o.Parent = holder end
				stripScripts(holder)
				skinCache = holder
				return holder
			end
			local ok2, res = pcall(function() return game:GetService("InsertService"):LoadAsset(SKIN_ID) end)
			if ok2 and res then skinCache = res return res end
			return nil
		end
		local DEFAULT_ANIMS = {
			R15 = { idle = "rbxassetid://507766666", walk = "rbxassetid://507777826", run = "rbxassetid://507767714", jump = "rbxassetid://507765000", fall = "rbxassetid://507767968", climb = "rbxassetid://507765644", sit = "rbxassetid://507768375" },
			R6  = { idle = "rbxassetid://180435571", walk = "rbxassetid://180426354", run = "rbxassetid://180426354", jump = "rbxassetid://125750702", fall = "rbxassetid://180436148", climb = "rbxassetid://180436334", sit = "rbxassetid://178130996" },
		}
		local LOOPED = { idle = true, walk = true, run = true, fall = true, climb = true, sit = true, jump = false }
		local function destroySkinState()
			_G.__orionSkinHead = nil
			if not skinState then return end
			for _, c in ipairs(skinState.conns) do c:Disconnect() end
			for inst, v in pairs(skinState.orig) do
				if inst.Parent then inst.Transparency = v end
			end
			if skinState.folder then skinState.folder:Destroy() end
			skinState = nil
		end
		local function buildSkin(m)
			destroySkinState()
			local c = char() if not c then return end
			local h = c:FindFirstChildOfClass("Humanoid")
			local hrp = c:FindFirstChild("HumanoidRootPart")
			if not (h and hrp) then return end
			local skinFolder = getSkinModel()
			if not skinFolder then
				warn("[Orion] Custom Player Model: не удалось загрузить модель " .. SKIN_ID)
				return
			end
			local skinSrc = nil
			for _, cc in ipairs(skinFolder:GetChildren()) do
				if cc:IsA("Model") then skinSrc = cc break end
			end
			if not skinSrc then skinSrc = skinFolder:FindFirstChildWhichIsA("Model", true) end
			if not skinSrc then return end
			local model = skinSrc:Clone()
			stripScripts(model)
			local cloneRoot = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
			if not cloneRoot then model:Destroy() return end
			local cloneHum = model:FindFirstChildOfClass("Humanoid")
			local rigType = cloneHum and cloneHum.RigType or (model:FindFirstChild("UpperTorso") and Enum.HumanoidRigType.R15 or Enum.HumanoidRigType.R6)
			local function feetOffset(root, hum)
				if hum and hum.RigType == Enum.HumanoidRigType.R6 then return 3 end
				return root.Size.Y / 2 + (hum and hum.HipHeight or 2)
			end
			local charOff = feetOffset(hrp, h)
			local cloneOff = cloneHum and feetOffset(cloneRoot, cloneHum) or charOff
			local dy = cloneOff - charOff
			if math.abs(dy) > 6 then dy = 0 end
			local rootOffset = CFrame.new(0, dy, 0)
			if cloneHum then cloneHum:Destroy() end
			local controller = Instance.new("AnimationController")
			controller.Parent = model
			local cloneAnimator = Instance.new("Animator")
			cloneAnimator.Parent = controller
			local skinParts = {}
			for _, d in ipairs(model:GetDescendants()) do
				if d:IsA("BasePart") then
					ghost(d, false)
					table.insert(skinParts, d)
				end
			end
			scaleHead(model, m.s["Head Scale"])
			local base0 = hrp.CFrame * rootOffset
			model:PivotTo((base0 * cloneRoot.CFrame:Inverse()) * model:GetPivot())
			skinState = { conns = {}, orig = {}, folder = Instance.new("Folder") }
			skinState.folder.Name = "FoxySkinFX"
			skinState.folder.Parent = Workspace
			model.Parent = skinState.folder
			local skinHead = model:FindFirstChild("Head", true)
			if skinHead then _G.__orionSkinHead = skinHead end
			local roots, seen = {}, {}
			for _, p in ipairs(skinParts) do
				local r = p:GetRootPart() or p
				if not seen[r] then
					seen[r] = true
					r.Anchored = true
					table.insert(roots, { part = r, rel = cloneRoot.CFrame:ToObjectSpace(r.CFrame) })
				end
			end
			local rigName = (rigType == Enum.HumanoidRigType.R6) and "R6" or "R15"
			local canMirror = (h.RigType == rigType)
			local cloneTracks = {}
			local defTracks = {}
			local curKey, curTrack = nil, nil
			local function mirrorStep()
				local ca = h:FindFirstChildOfClass("Animator")
				if not ca then return 0 end
				local seenIds, n = {}, 0
				for _, t in ipairs(ca:GetPlayingAnimationTracks()) do
					local anim = t.Animation
					local id = anim and anim.AnimationId or ""
					if id ~= "" then
						seenIds[id] = true
						n += 1
						local ct = cloneTracks[id]
						if not ct then
							local a = Instance.new("Animation")
							a.AnimationId = id
							ct = cloneAnimator:LoadAnimation(a)
							cloneTracks[id] = ct
						end
						ct.Priority = t.Priority
						ct.Looped = t.Looped
						if not ct.IsPlaying then ct:Play(0.1, math.max(t.WeightCurrent, 0.001), t.Speed) end
						ct:AdjustWeight(math.max(t.WeightCurrent, 0.001), 0)
						ct:AdjustSpeed(t.Speed)
						if math.abs(ct.TimePosition - t.TimePosition) > 0.15 then ct.TimePosition = t.TimePosition end
					end
				end
				for id, ct in pairs(cloneTracks) do
					if not seenIds[id] and ct.IsPlaying then ct:Stop(0.15) end
				end
				return n
			end
			local function getDef(key)
				if defTracks[key] then return defTracks[key] end
				local a = Instance.new("Animation")
				a.AnimationId = DEFAULT_ANIMS[rigName][key]
				local tr = cloneAnimator:LoadAnimation(a)
				tr.Looped = LOOPED[key] == true
				defTracks[key] = tr
				return tr
			end
			local function stopDefaults()
				if curTrack then curTrack:Stop(0.15) curTrack, curKey = nil, nil end
			end
			local function defaultsStep()
				local st = h:GetState()
				local v = hrp.AssemblyLinearVelocity
				local speed = Vector3.new(v.X, 0, v.Z).Magnitude
				local key
				if st == Enum.HumanoidStateType.Jumping then key = "jump"
				elseif st == Enum.HumanoidStateType.Freefall then key = "fall"
				elseif st == Enum.HumanoidStateType.Climbing then key = "climb"
				elseif st == Enum.HumanoidStateType.Seated then key = "sit"
				elseif speed > 0.75 then key = (speed > 14) and "run" or "walk"
				else key = "idle" end
				if key ~= curKey then
					if curTrack then curTrack:Stop(0.15) end
					curKey = key
					curTrack = getDef(key)
					curTrack:Play(0.15)
				end
				if curTrack and (key == "walk" or key == "run") then
					curTrack:AdjustSpeed(math.clamp(speed / 14.5, 0.4, 2))
				end
			end
			local function hideOriginal(d)
				if d:FindFirstAncestorOfClass("Tool") then return end
				if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture") then
					if skinState.orig[d] == nil then skinState.orig[d] = d.Transparency end
					d.Transparency = 1
				end
			end
			for _, d in ipairs(c:GetDescendants()) do hideOriginal(d) end
			table.insert(skinState.conns, c.DescendantAdded:Connect(hideOriginal))
			local cam = Workspace.CurrentCamera
			local function skinUpdate()
				local base = hrp.CFrame * rootOffset
				for _, r in ipairs(roots) do r.part.CFrame = base * r.rel end
				local n = 0
				if canMirror then n = mirrorStep() end
				if n == 0 then defaultsStep() else stopDefaults() end
				if cam then
					local head = c:FindFirstChild("Head")
					if head and #skinParts > 0 then
						local ltm = ((cam.CFrame.Position - head.Position).Magnitude < 1.3) and 1 or 0
						for _, p in ipairs(skinParts) do p.LocalTransparencyModifier = ltm end
					end
				end
			end
			table.insert(skinState.conns, RunService.RenderStepped:Connect(function()
				local ok, err = pcall(skinUpdate)
				if not ok then
					warn("[Orion] Custom Player Model: " .. tostring(err))
					destroySkinState()
				end
			end))
			table.insert(skinState.conns, h.Died:Connect(destroySkinState))
		end
		add("Render", "Custom Player Model", "Надевает скин-скелет", {
			{ type = "slider", name = "Head Scale", min = 1, max = 3, step = 0.1, value = 1.5 },
		}, {
			onEnable = function(m)
				skinEnabled = true
				safeSpawn(function() safeWait(1) buildSkin(m) end)
				skinCharConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
					if not skinEnabled then return end
					safeSpawn(function()
						newChar:WaitForChild("Humanoid", 10)
						newChar:WaitForChild("HumanoidRootPart", 10)
						safeWait(1)
						if skinEnabled then buildSkin(m) end
					end)
				end)
			end,
			onStep = function(m)
				if skinState and skinState.folder then
					if m._lastHeadScale ~= m.s["Head Scale"] then
						m._lastHeadScale = m.s["Head Scale"]
						safeSpawn(function() buildSkin(m) end)
					end
				end
			end,
			onDisable = function()
				skinEnabled = false
				if skinCharConn then skinCharConn:Disconnect() skinCharConn = nil end
				destroySkinState()
			end,
		})
	end

	print("[Orion] Part 5/6 loaded")
end

