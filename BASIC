				corner(box, 6)
				local fill = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1 }, box)
				corner(fill, 6)
				accent(fill, 45)
				local function visual(instant)
					local on = m.s[d.name]
					local goal = { Size = on and UDim2.fromScale(1, 1) or UDim2.fromScale(0, 0), BackgroundTransparency = on and 0 or 1 }
					if instant then
