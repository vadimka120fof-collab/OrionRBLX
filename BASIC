				for _, a in ipairs(footRingAnimated) do a.grad.Rotation = (a.off + t * a.spd) % 360 end
				for _, o in ipairs(footRingOrbits) do
					local ang = o.phase + t * o.w
					local h = 0.2
					if FOOT_RING_CFG.Rise then
						h = 0.2 + (math.sin(t * o.hSpeed + o.phase) * 0.5 + 0.5) * o.hMax
					end
					o.part.CFrame = center * CFrame.new(math.cos(ang) * o.r, h, math.sin(ang) * o.r)
				end
			end)
