	local antiAimState = nil
	local function destroyAntiAim()
		if antiAimState then
			if antiAimState.conn then antiAimState.conn:Disconnect() antiAimState.conn = nil end
			antiAimState = nil
		end
		_G.__antiAimYFreeze.enabled = false
		_G.__antiAimYFreeze.y = nil
	end
	local function buildAntiAim(m)
		destroyAntiAim()
		local r0 = root() if not r0 then return end
		local cam0 = Workspace.CurrentCamera
		if not cam0 then return end
		_G.__antiAimYFreeze.y = r0.Position.Y
		_G.__antiAimYFreeze.enabled = true
		local st = {
			virtualPos = r0.Position,
			virtualLook = cam0.CFrame.LookVector,
			lastTick = 0,
			prevPos = r0.Position,
			conn = nil,
		}
		antiAimState = st
		st.conn = RunService.RenderStepped:Connect(function(dt)
			local c = char() if not c then return end
			local r = c:FindFirstChild("HumanoidRootPart")
			local cam = Workspace.CurrentCamera
			if not (r and cam) then return end
			local radius = m.s.Radius
			local tickDelay = m.s["Tick Delay"]
			local camHeight = m.s["Camera Height"] or 5
			local camDistance = m.s["Camera Distance"] or 0
			local cur = r.Position
			local delta = cur - st.prevPos
			local dLen = delta.Magnitude
			if dLen > 0 and dLen < radius * 0.6 then st.virtualPos = st.virtualPos + delta end
			st.prevPos = cur
			st.virtualLook = cam.CFrame.LookVector
			local camPos = st.virtualPos + Vector3.new(0, camHeight, 0) - st.virtualLook * camDistance
			cam.CFrame = CFrame.lookAt(camPos, camPos + st.virtualLook)
			if os.clock() - st.lastTick >= tickDelay then
				st.lastTick = os.clock()
				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Exclude
				params.FilterDescendantsInstances = { c, cam }
				params.IgnoreWater = true
				local attempts = 30
				local newPos = nil
				for _ = 1, attempts do
					local ang = math.random() * math.pi * 2
					local rr = radius * math.sqrt(math.random())
					local offset = Vector3.new(math.cos(ang) * rr, 0, math.sin(ang) * rr)
					local testXZ = st.virtualPos + offset
					local origin = Vector3.new(testXZ.X, st.virtualPos.Y + 5, testXZ.Z)
					local downRay = Workspace:Raycast(origin, Vector3.new(0, -60, 0), params)
					if downRay then
						newPos = Vector3.new(testXZ.X, downRay.Position.Y + 3, testXZ.Z)
						break
					end
				end
				if newPos then
					r.CFrame = CFrame.new(newPos, newPos + st.virtualLook)
					st.virtualPos = newPos
					st.prevPos = newPos
				end
			end
		end)
	end
