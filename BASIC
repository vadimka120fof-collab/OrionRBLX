-- ЗАЩИТА ОТ nil-CFrame ошибок
-- ============================================================
do
	local ScriptContext = game:GetService("ScriptContext")
	local lastErrorTime = 0
	local errorCount = 0
	local disabledSuspects = {}
	ScriptContext.Error:Connect(function(msg, trace, script)
		if not string.find(msg, "attempt to index nil with 'CFrame'") then return end
		local now = os.clock()
		if now - lastErrorTime < 0.5 then errorCount = errorCount + 1
		else errorCount = 1 lastErrorTime = now end
		if errorCount > 10 then
			local suspects = { "Render/Wings", "Render/Anime Aura", "Render/Aura", "Render/Foot Vortex" }
			for _, key in ipairs(suspects) do
				local mod = byName[key]
				if mod and mod.on and not disabledSuspects[key] then
					disabledSuspects[key] = true
					safeSpawn(function()
						pcall(function() if mod.hooks.onDisable then mod.hooks.onDisable(mod) end end)
						mod.on = false
						if mod.refresh then pcall(mod.refresh) end
					end)
				end
			end
			errorCount = 0
		end
	end)
end

