							local h = ch:FindFirstChildOfClass("Humanoid") or ch:WaitForChild("Humanoid", 10)
							if not h then return end
							h.Died:Connect(function() onDeath(plr, h) end)
							h.HealthChanged:Connect(function(hp) if hp <= 0 then onDeath(plr, h) else stormKillHandled[h] = nil end end)
						end)
					end
					local function hookPlr(plr)
						if plr.Character then hookChar(plr, plr.Character) end
						plr.CharacterAdded:Connect(function(ch) hookChar(plr, ch) end)
					end
