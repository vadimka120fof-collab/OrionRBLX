		local data = { modules = {}, theme = theme[1] }
		for _, m in ipairs(modules) do data.modules[m.tab .. "/" .. m.name] = serializeModule(m) end
		return data
	end
	local function applyAll(data)
		if type(data) ~= "table" then return end
		if data.theme then
			for _, t in ipairs(THEMES) do if t[1] == data.theme then setTheme(t) break end end
		end
		if data.modules then
			for key, entry in pairs(data.modules) do
				local m = byName[key]
				if m then applyModule(m, entry) end
			end
		end
	end
