		-- Lightning из модели 129395397799333
		local FX_ASSET_ID = 129395397799333
		local function findLightning()
			local pre = ReplicatedStorage:FindFirstChild("FoxyAssets")
			local holder = pre and pre:FindFirstChild("FX" .. tostring(FX_ASSET_ID))
			if not holder then
				local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. FX_ASSET_ID) end)
				if ok and type(objs) == "table" and #objs > 0 then
					holder = Instance.new("Folder")
					holder.Name = "FoxyFXHolder"
					for _, o in ipairs(objs) do o.Parent = holder end
					stripScripts(holder)
					if pre then holder.Parent = pre else holder.Parent = ReplicatedStorage end
				end
			end
			if not holder then return nil end
			for _, d in ipairs(holder:GetDescendants()) do
				local n = string.lower(d.Name)
				if (d:IsA("Model") or d:IsA("Folder")) and
					(string.find(n, "lightning", 1, true) or string.find(n, "thunder", 1, true) or string.find(n, "storm", 1, true)) then
					return d
				end
			end
			for _, top in ipairs(holder:GetChildren()) do
				for _, d in ipairs(top:GetDescendants()) do
					if d:IsA("Beam") or d:IsA("Trail") then return top end
				end
			end
			return nil
		end
		local function cloneFXPart(src)
			if not src then return nil end
			local cl = src:Clone()
			stripScripts(cl)
			destroyMatching(cl, { "Humanoid", "JointInstance", "WeldConstraint", "Shirt", "Pants", "ShirtGraphic", "BodyColors", "CharacterMesh", "Animator", "AnimationController", "Animation" })
			for _, d in ipairs(cl:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = false
					d.CanCollide = false
					d.CanTouch = false
					d.CanQuery = false
					d.Massless = true
					d.Transparency = 1
				end
			end
			if cl:IsA("BasePart") then
				cl.Anchored = false
				cl.CanCollide = false
				cl.Transparency = 1
			end
			return cl
		end
		local function playLightning(plr, m)
			local ch = plr and plr.Character
			if not ch then return end
			local torso = ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso") or ch:FindFirstChild("LowerTorso") or ch:FindFirstChild("HumanoidRootPart")
			if not torso then return end
			local pos = torso.Position + Vector3.new(0, m.s["Lift Offset"] or 6, 0)
			local src = findLightning()
			if not src then return end
			local folder = new("Folder", { Name = "Lightning" }, Workspace)
			local cl = cloneFXPart(src)
			if not cl then folder:Destroy() return end
			cl.Parent = folder
			if cl:IsA("Model") then
				cl:PivotTo(CFrame.new(pos))
			elseif cl:IsA("BasePart") then
				cl.CFrame = CFrame.new(pos)
			else
				local first = cl:FindFirstChildWhichIsA("BasePart", true)
				if first then
					local offset = pos - first.Position
					for _, d in ipairs(cl:GetDescendants()) do
						if d:IsA("BasePart") then d.CFrame = d.CFrame + offset end
					end
				end
			end
			local col = m.s["Lightning Color"] or Color3.fromRGB(180, 220, 255)
			for _, d in ipairs(cl:GetDescendants()) do
				if d:IsA("ParticleEmitter") then d.Color = ColorSequence.new(col)
				elseif d:IsA("Beam") then d.Color = ColorSequence.new(col)
				elseif d:IsA("Trail") then d.Color = ColorSequence.new(col)
				elseif d:IsA("PointLight") then d.Color = col end
			end
			Debris:AddItem(folder, (m.s.Duration or 1) + 0.5)
		end

