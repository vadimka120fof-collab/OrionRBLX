-- ORION BASIC PATCH v3 (fixed)
-- Блокирует Anti-Aim / Gun Mod / Arrows для BASIC-ключа,
-- рисует замок и "Доступно в Premium", тема оранжевая.
-- ============================================================
do
	safeSpawn(function()
		safeWait(2)

		-- ВРЕМЕННО: форсим BASIC. Потом заменишь на _G.__orionKeyType or "BASIC"
		local keyType = "BASIC"
		local isPremium = (keyType == "PREMIUM")

		local THEMESref = THEMES or _G.__orionTHEMES
		local setThemeref = setTheme or _G.__orionSetTheme

		print("[Orion BasicPatch] keyType =", keyType)

		-- ============================================================
		-- 1) ТЕМА: для BASIC — Dark Orange
		-- ============================================================
		if (not isPremium) and THEMESref and setThemeref then
			local orangeTheme = nil
			for _, t in ipairs(THEMESref) do
				if t[1] == "Dark Orange" then
					orangeTheme = t
					break
				end
			end
			if orangeTheme then
				pcall(setThemeref, orangeTheme)
				print("[Orion BasicPatch] Тема: Dark Orange")
			end
		end

		-- ============================================================
		-- 2) БЕЙДЖ под Orion
		-- ============================================================
		local PlayerGui = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
		if not PlayerGui then return end
		local gui = PlayerGui:FindFirstChild("Orion_Menu")
		if not gui then
			warn("[Orion BasicPatch] Orion_Menu не найден")
			return
		end
		local main = gui:FindFirstChild("Main")
		if not main then return end

		local titleLabel = nil
		for _, d in ipairs(main:GetDescendants()) do
			if d:IsA("TextLabel") and d.Text == "Orion" and d.TextSize >= 18 then
				titleLabel = d
				break
			end
		end

		if titleLabel then
			local old = titleLabel:FindFirstChild("OrionBadge")
			if old then old:Destroy() end

			local badgeColor = isPremium and Color3.fromRGB(200, 130, 255) or Color3.fromRGB(255, 140, 40)

			titleLabel.ClipsDescendants = false
			local p = titleLabel.Parent
			while p and p ~= main do
				if p:IsA("GuiObject") and p.ClipsDescendants then
					p.ClipsDescendants = false
				end
				p = p.Parent
			end

			local badge = Instance.new("TextLabel")
			badge.Name = "OrionBadge"
			badge.BackgroundTransparency = 1
			badge.Text = isPremium and "PREMIUM" or "BASIC"
			badge.Font = Enum.Font.GothamBold
			badge.TextColor3 = badgeColor
			badge.TextXAlignment = Enum.TextXAlignment.Left
			badge.TextYAlignment = Enum.TextYAlignment.Center
			badge.TextSize = 14
			badge.Position = UDim2.fromOffset(0, titleLabel.AbsoluteSize.Y - 4)
			badge.Size = UDim2.fromOffset(120, 18)
			badge.AnchorPoint = Vector2.new(0, 0)
			badge.ZIndex = titleLabel.ZIndex + 2
			badge.Parent = titleLabel
		end

		-- ============================================================
		-- 3) БЛОКИРОВКА МОДУЛЕЙ
		-- ============================================================
		if isPremium then
			print("[Orion BasicPatch] PREMIUM — блокировка не применяется")
			return
		end

		local LOCKED_MODULES = {
			["Combat/Anti-Aim"] = true,
			["Combat/Gun Mod (Rapid Fire)"] = true,
			["Render/Arrows"] = true,
		}

		local function lockModule(mod)
			if not mod then return end
			if mod.__basicLocked then return end
			mod.__basicLocked = true

			-- Глушим onEnable
			if mod.hooks then
				mod.hooks.onEnable = function()
					if mod.on then
						mod.on = false
						if mod.refresh then pcall(mod.refresh) end
					end
				end
				mod.hooks.onStep = function() end
			end

			-- Если включён — выключаем
			if mod.on then
				mod.on = false
				if mod.hooks and mod.hooks.onDisable then
					pcall(mod.hooks.onDisable, mod)
				end
				if mod.refresh then pcall(mod.refresh) end
			end

			-- Убираем бинд
			mod.bind = nil
			if mod.refresh then pcall(mod.refresh) end

			-- Закрываем окно настроек
			if mod.win and mod.winOpen then
				mod.winOpen = false
				pcall(function()
					if popup then popup(mod.win, false) end
				end)
			end
		end

		for key in pairs(LOCKED_MODULES) do
			local mod = byName and byName[key]
			if mod then
				lockModule(mod)
				print("[Orion BasicPatch] Заблокирован:", key)
			else
				warn("[Orion BasicPatch] Не найден модуль:", key)
			end
		end

		-- ============================================================
		-- 4) ОВЕРЛЕЙ: затемнение + замок + текст
		-- ============================================================
		local LOCK_ICON_ID = "rbxassetid://10011675524"

		local function addLockOverlay(card)
			if not card or not card.Parent then return end
			if card:FindFirstChild("BasicLockOverlay") then return end

			-- Затемнение
			local overlay = Instance.new("Frame")
			overlay.Name = "BasicLockOverlay"
			overlay.Size = UDim2.fromScale(1, 1)
			overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
			overlay.BackgroundTransparency = 0.55
			overlay.BorderSizePixel = 0
			overlay.ZIndex = 100
			overlay.Active = true
			overlay.Parent = card
			local oc = Instance.new("UICorner")
			oc.CornerRadius = UDim.new(0, 10)
			oc.Parent = overlay

			-- Блокировщик кликов
			local blocker = Instance.new("TextButton")
			blocker.Name = "ClickBlocker"
			blocker.Size = UDim2.fromScale(1, 1)
			blocker.BackgroundTransparency = 1
			blocker.Text = ""
			blocker.AutoButtonColor = false
			blocker.ZIndex = 200
			blocker.Parent = overlay
			blocker.MouseButton1Click:Connect(function() end)
			blocker.MouseButton2Click:Connect(function() end)
			blocker.MouseButton1Down:Connect(function() end)
			blocker.MouseButton2Down:Connect(function() end)

			-- Замок
			local lockImg = Instance.new("ImageLabel")
			lockImg.Name = "LockIcon"
			lockImg.BackgroundTransparency = 1
			lockImg.Image = LOCK_ICON_ID
			lockImg.ImageColor3 = Color3.fromRGB(255, 220, 130)
			lockImg.Size = UDim2.fromOffset(28, 28)
			lockImg.Position = UDim2.new(0.5, 0, 0.5, -12)
			lockImg.AnchorPoint = Vector2.new(0.5, 0.5)
			lockImg.ZIndex = 201
			lockImg.Parent = overlay

			-- Текст
			local lbl = Instance.new("TextLabel")
			lbl.Name = "LockText"
			lbl.BackgroundTransparency = 1
			lbl.Text = "Доступно в Premium"
			lbl.Font = Enum.Font.GothamBold
			lbl.TextSize = 11
			lbl.TextColor3 = Color3.fromRGB(255, 200, 100)
			lbl.TextXAlignment = Enum.TextXAlignment.Center
			lbl.TextYAlignment = Enum.TextYAlignment.Center
			lbl.Position = UDim2.new(0.5, 0, 0.5, 12)
			lbl.AnchorPoint = Vector2.new(0.5, 0.5)
			lbl.Size = UDim2.new(1, -10, 0, 16)
			lbl.ZIndex = 201
			lbl.Parent = overlay

			card:SetAttribute("__basicLockedCard", true)
			card.AutoButtonColor = false
		end

		local function applyLocks()
			for key in pairs(LOCKED_MODULES) do
				local mod = byName and byName[key]
				if mod and mod.card and mod.card.Parent then
					addLockOverlay(mod.card)
				end
			end
		end

		applyLocks()

		task.spawn(function()
			while gui and gui.Parent do
				task.wait(1)
				applyLocks()
			end
		end)

		-- ============================================================
		-- 5) БЛОКИРОВКА КЛАВИШ БИНДА
		-- ============================================================
		local UIS = game:GetService("UserInputService")
		UIS.InputBegan:Connect(function(input, gpe)
			if gpe then return end
			if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
			for key in pairs(LOCKED_MODULES) do
				local mod = byName and byName[key]
				if mod and mod.on then
					mod.on = false
					if mod.hooks and mod.hooks.onDisable then
						pcall(mod.hooks.onDisable, mod)
					end
					if mod.refresh then pcall(mod.refresh) end
				end
			end
		end)

		print("[Orion BasicPatch] Готово: 3 модуля заблокированы")
	end)
