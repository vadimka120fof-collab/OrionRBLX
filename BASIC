						local slot = r.LayoutOrder
						if _G.__orionConfigNames[slot] then box.Text = _G.__orionConfigNames[slot] end
						box:GetPropertyChangedSignal("Text"):Connect(function()
							_G.__orionConfigNames[slot] = box.Text
						end)
						local saveBtn, loadBtn
						for _, c in ipairs(r:GetChildren()) do
							if c:IsA("TextButton") then
								if c.Text == "Save" then saveBtn = c
								elseif c.Text == "Load" then loadBtn = c end
							end
						end
						if saveBtn then
							saveBtn.MouseButton1Click:Connect(function()
								safeSpawn(function()
									safeWait(0.15)
									local path = "Orion_Configs/slot" .. slot .. ".json"
									if typeof(isfile) == "function" and isfile(path) then
										local ok, content = pcall(readfile, path)
										if ok and content then
											local ok2, data = pcall(HttpService.JSONDecode, HttpService, content)
											if ok2 and data then
												data.name = _G.__orionConfigNames[slot] or ("Config " .. slot)
												local ok3, j = pcall(HttpService.JSONEncode, HttpService, data)
												if ok3 then pcall(writefile, path, j) end
											end
										end
									end
								end)
							end)
						end
						if loadBtn then
							loadBtn.MouseButton1Click:Connect(function()
								safeSpawn(function()
									safeWait(0.1)
									local path = "Orion_Configs/slot" .. slot .. ".json"
									if typeof(isfile) == "function" and isfile(path) then
										local ok, content = pcall(readfile, path)
										if ok and content then
											local ok2, data = pcall(HttpService.JSONDecode, HttpService, content)
											if ok2 and data and data.name then
												local box2 = r:FindFirstChild("NameBox")
												if box2 then box2.Text = data.name end
												_G.__orionConfigNames[slot] = data.name
											end
										end
									end
								end)
							end)
						end
					end
				end
			end
			task.spawn(function()
				while gui and gui.Parent do
					task.wait(1)
					for slot = 1, 5 do
						local path = "Orion_Configs/slot" .. slot .. ".json"
						if typeof(isfile) == "function" and isfile(path) then
							local ok, content = pcall(readfile, path)
							if ok and content then
								local ok2, data = pcall(HttpService.JSONDecode, HttpService, content)
								if ok2 and data then
									local stored = _G.__orionConfigNames[slot]
									if stored and data.name ~= stored then
										data.name = stored
										local ok3, j = pcall(HttpService.JSONEncode, HttpService, data)
										if ok3 then pcall(writefile, path, j) end
									end
								end
							end
						end
					end
				end
			end)
		end

		print("[Orion] Fix v60 applied — Time Changer + Strafe (fixed) + Fog + Attack Aura removed")
	end)
end

-- ============================================================
-- DIAGNOSTIC — Silent Aim camera debug
-- ============================================================
do
	safeSpawn(function()
		safeWait(2)

		local log = {}
		local function dprint(...)
			local parts = {}
			for _, v in ipairs({...}) do table.insert(parts, tostring(v)) end
			local s = table.concat(parts, " ")
			table.insert(log, s)
			print("[Orion-DIAG] " .. s)
		end

		dprint("=== Diagnostics started ===")

		-- 1. Проверка: какие модули включены
		local function listOn()
			local on = {}
			for _, m in ipairs(modules) do
				if m.on then table.insert(on, m.tab .. "/" .. m.name) end
			end
			return table.concat(on, ", ")
		end
		dprint("Active modules:", listOn())

		-- 2. Следим за Camera.CFrame — кто его меняет и как часто
		local cam = Workspace.CurrentCamera
		local lastCF = cam and cam.CFrame or CFrame.new()
		local lastChangeT = os.clock()
		local bigJumpCount = 0
		local lastBigJump = 0
		local jumpLog = {}

		RunService.RenderStepped:Connect(function()
			local c = Workspace.CurrentCamera
			if not c then return end
			local now = os.clock()
			local cur = c.CFrame
			local delta = (cur.Position - lastCF.Position).Magnitude
			local angleDelta = math.deg(math.acos(math.clamp(cur.LookVector:Dot(lastCF.LookVector), -1, 1)))
			if delta > 5 or angleDelta > 30 then
				bigJumpCount = bigJumpCount + 1
				if now - lastBigJump > 0.2 then
					lastBigJump = now
					local msg = string.format("CAM JUMP: pos %.1f studs, angle %.1f deg", delta, angleDelta)
					dprint(msg)
					table.insert(jumpLog, { t = now, msg = msg })
				end
			end
			lastCF = cur
			lastChangeT = now
		end)

		-- 3. Следим за Humanoid.CameraOffset и Head.CFrame
		LocalPlayer.CharacterAdded:Connect(function(ch)
			safeSpawn(function()
				local h = ch:WaitForChild("Humanoid", 10)
				local head = ch:WaitForChild("Head", 10)
				if h then
					local lastOffset = h.CameraOffset
					h:GetPropertyChangedSignal("CameraOffset"):Connect(function()
						if (h.CameraOffset - lastOffset).Magnitude > 0.5 then
							dprint("Humanoid.CameraOffset changed:", tostring(h.CameraOffset))
							lastOffset = h.CameraOffset
						end
					end)
				end
				if head then
					local lastHeadCF = head.CFrame
					RunService.RenderStepped:Connect(function()
						local d = (head.CFrame.Position - lastHeadCF.Position).Magnitude
						local a = math.deg(math.acos(math.clamp(head.CFrame.LookVector:Dot(lastHeadCF.LookVector), -1, 1)))
						if d > 3 or a > 20 then
							dprint(string.format("HEAD JUMP: %.1f studs, %.1f deg", d, a))
						end
						lastHeadCF = head.CFrame
					end)
				end
			end)
		end)
		if LocalPlayer.Character then
			local ch = LocalPlayer.Character
			local h = ch:FindFirstChildOfClass("Humanoid")
			local head = ch:FindFirstChild("Head")
			if h then
				local lastOffset = h.CameraOffset
				h:GetPropertyChangedSignal("CameraOffset"):Connect(function()
					if (h.CameraOffset - lastOffset).Magnitude > 0.5 then
						dprint("Humanoid.CameraOffset changed:", tostring(h.CameraOffset))
						lastOffset = h.CameraOffset
					end
				end)
			end
			if head then
				local lastHeadCF = head.CFrame
				RunService.RenderStepped:Connect(function()
					local d = (head.CFrame.Position - lastHeadCF.Position).Magnitude
					local a = math.deg(math.acos(math.clamp(head.CFrame.LookVector:Dot(lastHeadCF.LookVector), -1, 1)))
					if d > 3 or a > 20 then
						dprint(string.format("HEAD JUMP: %.1f studs, %.1f deg", d, a))
					end
					lastHeadCF = head.CFrame
				end)
			end
		end

		-- 4. Следим за позицией HumanoidRootPart
		local lastRootPos = nil
		RunService.Heartbeat:Connect(function()
			local c = LocalPlayer.Character
			local r = c and c:FindFirstChild("HumanoidRootPart")
			if r then
				if lastRootPos then
					local d = (r.Position - lastRootPos).Magnitude
					if d > 15 then
						dprint(string.format("ROOT TELEPORT: %.1f studs", d))
					end
				end
				lastRootPos = r.Position
			end
		end)

		-- 5. Следим за изменением sharedSilentTarget
		local lastTarget = nil
		RunService.RenderStepped:Connect(function()
			local t = sharedSilentTarget
			if t ~= lastTarget then
				if t and t.Parent then
					dprint("Silent target set:", t:GetFullName())
				else
					dprint("Silent target cleared")
				end
				lastTarget = t
			end
		end)

		-- 6. Перехватываем все записи в Camera.CFrame через metatable (если executor поддерживает)
		if hookmetamethod and getnamecallmethod and checkcaller and newcclosure then
			pcall(function()
				local old
				old = hookmetamethod(game, "__newindex", newcclosure(function(self, key, value)
					if self == Workspace.CurrentCamera and key == "CFrame" and not checkcaller() then
						local oldCF = Workspace.CurrentCamera.CFrame
						local d = (value.Position - oldCF.Position).Magnitude
						local a = math.deg(math.acos(math.clamp(value.LookVector:Dot(oldCF.LookVector), -1, 1)))
						if d > 5 or a > 30 then
							dprint(string.format("EXTERNAL cam.CFrame set: %.1f studs, %.1f deg", d, a))
						end
					end
					return old(self, key, value)
				end))
			end)
			dprint("Metamethod hook installed")
		else
			dprint("hookmetamethod unavailable — external camera writes not tracked")
		end

		-- 7. Финальный отчёт по запросу
		_G.__orionDiagDump = function()
			print("=== ORION DIAGNOSTIC DUMP ===")
			print("Active modules:", listOn())
			print("Camera jumps (large):", #jumpLog)
			for i, j in ipairs(jumpLog) do
				print(string.format("  [%d] %.2f: %s", i, j.t, j.msg))
			end
			print("=== END DUMP ===")
		end

		dprint("Diagnostics ready. Run _G.__orionDiagDump() in console for full report.")
	end)
end

