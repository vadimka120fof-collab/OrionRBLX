-- ESP / SKELETON / TRACERS / ARROWS render loops
-- ============================================================
do
	local function ensureEsp(plr)
		local o = espObjects[plr]
		if o then return o end
		local lbl = new("TextLabel", { AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1, RichText = true, Font = Enum.Font.GothamBold, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.2, TextYAlignment = Enum.TextYAlignment.Bottom, Active = false, Visible = false, ZIndex = 20 }, overlayGui)
		local highlight = new("Highlight", { FillTransparency = 0.7, OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Enabled = false }, overlayGui)
		local boxSides = {}
		for i = 1, 4 do
			local b = new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Visible = false, ZIndex = 19 }, overlayGui)
			corner(b, 2)
			table.insert(boxSides, b)
		end
		local healthBg = new("Frame", { BackgroundColor3 = Color3.fromRGB(20, 20, 20), BorderSizePixel = 0, Visible = false, ZIndex = 18 }, overlayGui)
		corner(healthBg, 2)
		local healthFill = new("Frame", { BackgroundColor3 = Color3.fromRGB(0, 255, 0), BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 19 }, healthBg)
		corner(healthFill, 2)
		o = { label = lbl, highlight = highlight, box = boxSides, healthBg = healthBg, healthFill = healthFill, skelLines = {}, skelIsR6 = nil }
		espObjects[plr] = o
		return o
	end
	local function destroyEsp(plr)
		local o = espObjects[plr]
		if not o then return end
		if o.label then o.label.Visible = false o.label:Destroy() end
		if o.highlight then o.highlight.Enabled = false o.highlight.Adornee = nil o.highlight:Destroy() end
		if o.box then for _, b in ipairs(o.box) do b.Visible = false b:Destroy() end end
		if o.healthBg then o.healthBg.Visible = false o.healthBg:Destroy() end
		if o.skelLines then for _, l in ipairs(o.skelLines) do l.Visible = false l:Destroy() end end
		espObjects[plr] = nil
	end
	local function escapeRich(t) return (t:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")) end
	local function rgbTag(c) return string.format("rgb(%d,%d,%d)", math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255)) end

	-- ESP + Skeleton
	connect(RunService.RenderStepped, function()
		local espM = byName["Render/ESP"]
		local skelM = byName["Render/Skeleton ESP"]
		local espEnabled = espM and espM.on
		local skelEnabled = skelM and skelM.on
		if not espEnabled and not skelEnabled then return end
		local cam = Workspace.CurrentCamera
		if not cam then return end
		local myRoot = root()
		local alivePlayers = {}
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				alivePlayers[plr] = true
				local ch = plr.Character
				local head = ch and ch:FindFirstChild("Head")
				local r = ch and ch:FindFirstChild("HumanoidRootPart")
				local h = ch and ch:FindFirstChildOfClass("Humanoid")
				local visible = head and r and h and h.Health > 0 and head.Parent ~= nil
				local dist = 0
				if visible and myRoot then
					dist = (r.Position - myRoot.Position).Magnitude
					if espM and espM.on and dist > espM.s["Max Distance"] then visible = false end
					if espM and teamIgnored(plr) then visible = false end
				end
				if visible and espEnabled then
					local o = ensureEsp(plr)
					local friend = isFriend(plr)
					local teamColor = friend and FRIEND_COLOR or (plr.Team and plr.TeamColor.Color or Color3.new(1, 1, 1))
					local lines = {}
					if espM.s.Nickname or friend then
						local nm = escapeRich(plr.Name)
						if friend then nm = '<font color="rgb(80,255,100)">' .. nm .. ' [Friend]</font>' end
						table.insert(lines, nm)
					end
					if espM.s.Team then
						table.insert(lines, string.format('<font color="%s">[%s]</font>', rgbTag(teamColor), escapeRich(plr.Team and plr.Team.Name or "No team")))
					end
					if espM.s["Held Item"] then
						local tool = ch:FindFirstChildOfClass("Tool")
						table.insert(lines, string.format('<font color="rgb(255,225,120)">%s</font>', escapeRich(tool and tool.Name or "no item")))
					end
					if espM.s.Distance then
						table.insert(lines, string.format('<font color="rgb(190,190,205)">%d studs</font>', math.floor(dist)))
					end
					local pos, onScreen = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 1.3, 0))
					if onScreen and #lines > 0 then
						o.label.Text = table.concat(lines, "\n")
						o.label.TextSize = espM.s["Text Size"]
						o.label.Size = UDim2.fromOffset(260, #lines * (espM.s["Text Size"] + 3))
						o.label.Position = UDim2.fromOffset(pos.X, pos.Y)
						o.label.Visible = true
					else
						o.label.Visible = false
					end
					o.highlight.Adornee = ch
					o.highlight.FillColor = teamColor
					o.highlight.OutlineColor = teamColor
					o.highlight.Enabled = espM.s.Highlight

					if espM.s.Box then
						local minX, minY = math.huge, math.huge
						local maxX, maxY = -math.huge, -math.huge
						local anyVisible = false
						for _, p in ipairs(ch:GetChildren()) do
							if p:IsA("BasePart") then
								local sp, on = cam:WorldToViewportPoint(p.Position)
								if on then
									anyVisible = true
									if sp.X < minX then minX = sp.X end
									if sp.Y < minY then minY = sp.Y end
									if sp.X > maxX then maxX = sp.X end
									if sp.Y > maxY then maxY = sp.Y end
								end
							end
						end
						if anyVisible then
							local pad = 8
							minX -= pad maxX += pad minY -= pad maxY += pad
							local boxColor = friend and FRIEND_COLOR or teamColor
							local th = 1.5
							local w = maxX - minX
							local hh = maxY - minY
							o.box[1].BackgroundColor3 = boxColor o.box[1].Size = UDim2.fromOffset(w, th) o.box[1].Position = UDim2.fromOffset(minX, minY) o.box[1].Visible = true
							o.box[2].BackgroundColor3 = boxColor o.box[2].Size = UDim2.fromOffset(w, th) o.box[2].Position = UDim2.fromOffset(minX, maxY - th) o.box[2].Visible = true
							o.box[3].BackgroundColor3 = boxColor o.box[3].Size = UDim2.fromOffset(th, hh) o.box[3].Position = UDim2.fromOffset(minX, minY) o.box[3].Visible = true
							o.box[4].BackgroundColor3 = boxColor o.box[4].Size = UDim2.fromOffset(th, hh) o.box[4].Position = UDim2.fromOffset(maxX - th, minY) o.box[4].Visible = true
							if espM.s["Health Bar"] then
								local w2 = 3
								o.healthBg.Visible = true
								o.healthBg.Size = UDim2.fromOffset(w2, hh)
								o.healthBg.Position = UDim2.fromOffset(minX - w2 - 3, minY)
								local hp = math.clamp(h.Health / math.max(h.MaxHealth, 1), 0, 1)
								o.healthFill.Size = UDim2.fromScale(1, hp)
								o.healthFill.Position = UDim2.fromScale(0, 1 - hp)
								local col
