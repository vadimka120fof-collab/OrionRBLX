				Lighting.Ambient = origLight.Ambient:Lerp(c, s * 0.7)
				Lighting.OutdoorAmbient = origLight.OutdoorAmbient:Lerp(c, s * 0.7)
			else
				Lighting.Ambient = origLight.Ambient
				Lighting.OutdoorAmbient = origLight.OutdoorAmbient
			end
		end

		local function restore()
			if origLight then
				Lighting.Ambient = origLight.Ambient
				Lighting.OutdoorAmbient = origLight.OutdoorAmbient
				origLight = nil
			end
			if atmo and atmo.Parent then
