			for i = 1, FOOT_RING_CFG.Trails do footRingMakeOrbit(footRingFolder, i) end
			footRingDiedConn = hum.Died:Connect(destroyFootRing)
			local t0 = os.clock()
			footRingRenderConn = RunService.RenderStepped:Connect(function()
