					CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
					Size = Vector3.new(0.15, 1, 1),
					CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)),
					Transparency = 0.2,
				}, folder)
			end
			local spikes = {}
			for i = 1, 12 do
				local ang = (i / 12) * math.pi * 2
				local spike = new("Part", {
					Material = Enum.Material.Neon, Color = i % 2 == 0 and c1 or c2,
					Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
					Size = Vector3.new(thickness, thickness, radius * 0.4),
					CFrame = CFrame.new(pos + Vector3.new(math.cos(ang) * radius * 0.3, 0, math.sin(ang) * radius * 0.3)) * CFrame.Angles(0, -ang, 0),
					Transparency = 0.1,
				}, folder)
				spikes[i] = { part = spike, angle = ang }
			end
			local flash = new("Part", {
				Shape = Enum.PartType.Ball, Material = Enum.Material.SmoothPlastic,
				Color = baseColor, Anchored = true, CanCollide = false,
				CanQuery = false, CanTouch = false, CastShadow = false,
