	-- ============================================================
	-- Плавный пинг (5 сек) и FPS (3 сек)
	-- ============================================================
	local function smoothSet(label, fromVal, toVal, suffix, duration)
		local t0 = os.clock()
		local conn
		conn = RunService.RenderStepped:Connect(function()
			local t = (os.clock() - t0) / duration
			if t >= 1 then
				label.Text = tostring(toVal) .. suffix
				conn:Disconnect()
				return
			end
			local v = math.floor(fromVal + (toVal - fromVal) * t + 0.5)
			label.Text = tostring(v) .. suffix
		end)
	end
	local function getRealPing()
		local ok, v = pcall(function() return LocalPlayer:GetNetworkPing() end)
		if ok and v then return math.floor(v * 1000 + 0.5) end
		return 0
	end
	task.spawn(function()
		local last = 0
		while true do
			local now = getRealPing()
			smoothSet(pingText, last, now, " ms", 0.5)
			last = now
			task.wait(5)
		end
	end)
	task.spawn(function()
		local frames, acc = 0, 0
		RunService.RenderStepped:Connect(function(dt) frames += 1 acc += dt end)
		local last = 60
		while true do
			task.wait(3)
			local now = math.floor(frames / math.max(acc, 0.001) + 0.5)
			smoothSet(fpsText, last, now, " FPS", 0.5)
			last = now
			frames, acc = 0, 0
		end
	end)

