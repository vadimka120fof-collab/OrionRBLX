		-- ============================================================
		-- 5) STRAFE (правильная реализация)
		-- ============================================================
		-- Сохраняет velocity при смене направления, особенно в полёте.
		-- Если игрок меняет направление движения, старая velocity "добавляется"
		-- к новой через сохранение её длины и коррекцию курса плавно.
		if not byName["Movement/Strafe"] then
			add("Movement", "Strafe", "Не даёт сбросить скорость при резкой смене траектории", {
				{ type = "slider", name = "Preserve", min = 0, max = 100, step = 5, value = 85 },
				{ type = "toggle", name = "Only In Air", value = false },
			}, {
				onEnable = function(m)
					m._conn = RunService.Heartbeat:Connect(function()
						local c = char() if not c then return end
						local hrp = c:FindFirstChild("HumanoidRootPart")
						local h = c:FindFirstChildOfClass("Humanoid")
						if not (hrp and h) then return end

						if m.s["Only In Air"] then
							local state = h:GetState()
							if state ~= Enum.HumanoidStateType.Freefall and state ~= Enum.HumanoidStateType.Jumping then
								m._savedSpeed = nil
								return
							end
						end

						local vel = hrp.AssemblyLinearVelocity
						local flat = Vector3.new(vel.X, 0, vel.Z)
						local spd = flat.Magnitude

						-- Запоминаем максимальную достигнутую скорость
						if not m._savedSpeed or spd > m._savedSpeed then
							m._savedSpeed = spd
						end

						-- Если скорость упала — восстанавливаем
						if m._savedSpeed and m._savedSpeed > 1 and spd < m._savedSpeed * 0.95 then
							local preserve = m.s.Preserve / 100
							local dir
							if spd > 0.1 then
								dir = flat.Unit
							else
								-- Если скорости нет — берём направление движения мыши (или вперёд)
								local cam = Workspace.CurrentCamera
								if cam then
									dir = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z).Unit
								else
									dir = Vector3.new(1, 0, 0)
								end
							end
							local targetSpeed = m._savedSpeed * preserve + spd * (1 - preserve)
							local newFlat = dir * targetSpeed
							hrp.AssemblyLinearVelocity = Vector3.new(newFlat.X, vel.Y, newFlat.Z)
						end

						-- Плавно снижаем сохранённую скорость когда игрок стоит
						if spd < 1 then
							m._savedSpeed = math.max(0, (m._savedSpeed or 0) - 1)
						end
					end)
				end,
				onDisable = function(m)
					if m._conn then m._conn:Disconnect() m._conn = nil end
					m._savedSpeed = nil
				end,
			})
		end

