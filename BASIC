			{ type = "slider", name = "Height", min = 20, max = 200, step = 5, value = 80 },
			{ type = "slider", name = "Segments", min = 4, max = 30, step = 1, value = 12 },
			{ type = "slider", name = "Amplitude", min = 0.5, max = 15, step = 0.5, value = 4 },
			{ type = "slider", name = "Thickness", min = 0.1, max = 3, step = 0.1, value = 0.5 },
			{ type = "slider", name = "Ground Radius", min = 1, max = 20, step = 0.5, value = 6 },
			{ type = "slider", name = "Duration", min = 0.1, max = 2, step = 0.1, value = 0.5 },
			{ type = "toggle", name = "Also on my death", value = false },
		}, {
