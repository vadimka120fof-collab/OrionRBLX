		if i.UserInputType == Enum.UserInputType.MouseButton2 then aiming = true end
	end)
	connect(UIS.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton2 then aiming = false end
	end)
	RunService:BindToRenderStep("Orion_Aimbot", Enum.RenderPriority.Camera.Value + 1, function()
		local m = byName["Combat/Aimbot"]
		local cam = Workspace.CurrentCamera
		if not (m and m.on and cam) then return end
		if not aiming then return end
		local mousePos = cam.ViewportSize / 2
		local best, bestDist = nil, m.s.FOV
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				if not (m.s["Ignore Friends"] and isFriend(plr)) and not teamIgnored(plr) then
					local ch = plr.Character
					local head = ch and ch:FindFirstChild("Head")
					local h = ch and ch:FindFirstChildOfClass("Humanoid")
					if head and h and h.Health > 0 then
						local pos, onScreen = cam:WorldToViewportPoint(head.Position)
						if onScreen then
							local d = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
							if d < bestDist then
								if not m.s["Wall Check"] then
									best, bestDist = head, d
								else
									local params = RaycastParams.new()
									params.FilterType = Enum.RaycastFilterType.Exclude
									params.FilterDescendantsInstances = { char() }
									local r = Workspace:Raycast(cam.CFrame.Position, head.Position - cam.CFrame.Position, params)
									if not r or r.Instance:IsDescendantOf(ch) then best, bestDist = head, d end
								end
							end
						end
					end
				end
			end
		end
		if best then
