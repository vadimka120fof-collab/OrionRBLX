	do
		local stormKillHandled = setmetatable({}, { __mode = "k" })
		local stormKillLastPos = {}
		local function stormStrike(pos, m)
			local folder = new("Folder", { Name = "StormStrike" }, Workspace)
			local col = m.s.Color
			local height = m.s.Height
			local segments = math.floor(m.s.Segments)
			local thickness = m.s.Thickness
			local dur = m.s.Duration
			local amplitude = m.s.Amplitude
			local points = { Vector3.new(pos.X, pos.Y + height, pos.Z) }
			local cur = points[1]
			local stepH = height / segments
			for i = 1, segments - 1 do
				local nextY = cur.Y - stepH
				local offsetX = (math.random() - 0.5) * amplitude * 2
				local offsetZ = (math.random() - 0.5) * amplitude * 2
				local np = Vector3.new(pos.X + offsetX, nextY, pos.Z + offsetZ)
				table.insert(points, np)
				cur = np
			end
			table.insert(points, pos)
			local parts = {}
			for i = 1, #points - 1 do
				local a, b = points[i], points[i + 1]
				local len = (b - a).Magnitude
				if len > 0.05 then
					local cf = CFrame.lookAt(a, b) * CFrame.new(0, 0, -len / 2)
					table.insert(parts, new("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Material = Enum.Material.Neon, Color = col:Lerp(Color3.new(1,1,1), 0.6), Size = Vector3.new(thickness * 0.5, thickness * 0.5, len), CFrame = cf, Transparency = 0 }, folder))
					table.insert(parts, new("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Material = Enum.Material.Neon, Color = col, Size = Vector3.new(thickness * 2.5, thickness * 2.5, len), CFrame = cf, Transparency = 0.5 }, folder))
