	})

	add("Combat", "Aimbot", "Locks to nearest player (RMB)", {
		{ type = "slider", name = "FOV", min = 20, max = 500, step = 5, value = 120 },
		{ type = "slider", name = "Smoothness", min = 0.05, max = 1, step = 0.05, value = 0.4 },
		{ type = "toggle", name = "Wall Check", value = true },
		{ type = "toggle", name = "Ignore Friends", value = true },
		{ type = "toggle", name = "RGB Circle", value = false },
		{ type = "color2", name = "Circle Color", value1 = Color3.fromRGB(255, 255, 255), value2 = Color3.fromRGB(255, 60, 60) },
	}, {
		onEnable = function() fovCircle.Visible = true end,
		onDisable = function() fovCircle.Visible = false end,
		onStep = function(m)
			local cam = Workspace.CurrentCamera if not cam then return end
			fovCircle.Size = UDim2.fromOffset(m.s.FOV * 2, m.s.FOV * 2)
			local center = cam.ViewportSize / 2
			fovCircle.Position = UDim2.fromOffset(center.X, center.Y)
		end,
	})

	local silentInstalled = false
	local function installSilentHook()
		if silentInstalled then return end
		if not (hookmetamethod and getnamecallmethod and checkcaller and newcclosure) then return end
		pcall(function()
			local watched = {}
			local rs = game:GetService("ReplicatedStorage")
			for _, v in ipairs(rs:GetDescendants()) do
				if v:IsA("RemoteEvent") and (v.Name == "ShootEvent" or v.Name == "ReplicateEvent") then watched[v] = true end
			end
			local old
			old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
				local method = getnamecallmethod()
				if watched[self] and (method == "FireServer" or method == "InvokeServer") and not checkcaller() then
					local t = sharedSilentTarget
					if t and t.Parent then
						local origin = Workspace.CurrentCamera.CFrame.Position
						local toT = t.Position - origin
						if toT.Magnitude > 0.01 then
							local dir = toT.Unit
							local args = table.pack(...)
							for i = 1, args.n do
								local v = args[i]
								if typeof(v) == "Vector3" then
									if v.Magnitude < 10 then args[i] = dir * math.max(v.Magnitude, 1)
									elseif v.Magnitude > 100 then args[i] = t.Position end
								elseif typeof(v) == "CFrame" then
									args[i] = CFrame.new(v.Position, v.Position + dir)
								elseif typeof(v) == "table" then
									for k, val in pairs(v) do
										if typeof(val) == "Vector3" then
											if val.Magnitude < 10 then v[k] = dir
											elseif val.Magnitude > 100 then v[k] = t.Position end
										elseif typeof(val) == "CFrame" then
											v[k] = CFrame.new(val.Position, val.Position + dir)
										end
									end
								end
							end
							return old(self, table.unpack(args, 1, args.n))
						end
					end
				end
				if self == Workspace and method == "Raycast" and not checkcaller() then
					local t = sharedSilentTarget
					if t and t.Parent then
						local args = table.pack(...)
						local origin, d = args[1], args[2]
						if typeof(origin) == "Vector3" and typeof(d) == "Vector3" then
							local toT = t.Position - origin
							if toT.Magnitude > 0.01 then
								args[2] = toT.Unit * math.max(d.Magnitude, toT.Magnitude + 5)
								return old(self, table.unpack(args, 1, args.n))
							end
						end
					end
				end
				return old(self, ...)
			end))
		end)
		silentInstalled = true
	end
	installSilentHook()

	local function getTargetPart(plr)
		local ch = plr and plr.Character
		if not ch then return nil end
		local hb = byName["Combat/Hitboxes"]
		if hb and hb.on then
			local hrp = ch:FindFirstChild("HumanoidRootPart")
			if hrp then return hrp end
		end
		local head = ch:FindFirstChild("Head")
		if head then return head end
		return ch:FindFirstChild("HumanoidRootPart")
	end

	local function findSilentTarget(m)
		local fov = m.s.FOV
		local maxDist = m.s["Max Distance"]
		local teamCheck = m.s["Team Check"]
		local wallCheck = m.s["Wall Check"]
		local use360 = m.s["360 Aim"]
		local cam = Workspace.CurrentCamera if not cam then return nil end
		local mousePos = UIS:GetMouseLocation()
		local myRoot = root()
		local best, bestDist = nil, math.huge
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and not isFriend(plr) and not teamIgnored(plr) then
				if not (teamCheck and plr.Team == LocalPlayer.Team) then
					local ch = plr.Character
					if ch then
						local th = ch:FindFirstChildOfClass("Humanoid")
						if th and th.Health > 0 then
							local part = getTargetPart(plr)
							if part then
								local dist3D = 0 local skip = false
								if myRoot then
									dist3D = (part.Position - myRoot.Position).Magnitude
									if dist3D > maxDist then skip = true end
								end
								if not skip then
									local pass = false local cand = 0
									if use360 then pass = true cand = dist3D
									else
										local pos, onScreen = cam:WorldToViewportPoint(part.Position)
										if onScreen then
											local d = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
											if d < fov then pass = true cand = d end
										end
									end
									if pass and cand < bestDist then
										if wallCheck then
											local params = RaycastParams.new()
											params.FilterType = Enum.RaycastFilterType.Exclude
											params.FilterDescendantsInstances = { char() }
											local r = Workspace:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, params)
											if r and not r.Instance:IsDescendantOf(ch) then pass = false end
										end
										if pass then best, bestDist = part, cand end
									end
								end
							end
						end
					end
				end
			end
		end
		return best
	end
