	-- ============================================================
	-- Заливка полигона полосками (для логотипа и молнии)
	-- ============================================================
	local function fillPoly(parent, poly, color, step, W, H)
		local minY, maxY = math.huge, -math.huge
		for _, p in ipairs(poly) do
			minY = math.min(minY, p.Y)
			maxY = math.max(maxY, p.Y)
		end
		local n = #poly
		local y = minY + step / 2
		while y < maxY do
			local xs = {}
			for i = 1, n do
				local a, b = poly[i], poly[i % n + 1]
				if (a.Y <= y and b.Y > y) or (b.Y <= y and a.Y > y) then
					xs[#xs + 1] = a.X + (y - a.Y) / (b.Y - a.Y) * (b.X - a.X)
				end
			end
			table.sort(xs)
			for k = 1, #xs - 1, 2 do
				local x1, x2 = xs[k], xs[k + 1]
				if x2 - x1 > 0.01 then
					local f = Instance.new("Frame")
					f.BorderSizePixel = 0
					f.BackgroundColor3 = color
					f.Position = UDim2.fromScale(x1 / W, (y - step / 2) / H)
					f.Size = UDim2.fromScale((x2 - x1) / W, (step * 1.15) / H)
					f.Parent = parent
				end
			end
			y += step
		end
	end

	-- ============================================================
	-- Логотип
	-- ============================================================
	local LW, LH = 594, 443
	local function bez(p0, c, p2, n, out, skipFirst)
		for i = skipFirst and 1 or 0, n do
			local t = i / n
			local u = 1 - t
			out[#out + 1] = Vector2.new(
				u*u*p0.X + 2*u*t*c.X + t*t*p2.X,
				u*u*p0.Y + 2*u*t*c.Y + t*t*p2.Y
			)
		end
	end
	local function starPoly(cx, cy, top, bottom, left, right, kx, ky, n)
		local T = Vector2.new(cx, cy - top)
		local R = Vector2.new(cx + right, cy)
		local B = Vector2.new(cx, cy + bottom)
		local L = Vector2.new(cx - left, cy)
		local pts = {}
		bez(T, Vector2.new(cx + kx, cy - ky), R, n, pts, false)
		bez(R, Vector2.new(cx + kx, cy + ky), B, n, pts, true)
		bez(B, Vector2.new(cx - kx, cy + ky), L, n, pts, true)
		bez(L, Vector2.new(cx - kx, cy - ky), T, n, pts, true)
		return pts
	end
	local ELL = { cx = 292.5, cy = 230, a = 228, b = 78, rot = math.rad(-17.8) }
	local function ellipsePoint(phi)
		local x, y = ELL.a * math.cos(phi), ELL.b * math.sin(phi)
		local c, s = math.cos(ELL.rot), math.sin(ELL.rot)
		return Vector2.new(ELL.cx + x*c - y*s, ELL.cy + x*s + y*c)
	end
	local function bandPoly(phi0, phi1, wMax, peak, n)
		local p = math.log(0.5) / math.log(peak)
		local left, right = {}, {}
		for i = 0, n do
			local s = i / n
			local phi = math.rad(phi0 + (phi1 - phi0) * s)
			local pt = ellipsePoint(phi)
			local e = 1e-3
			local tan = (ellipsePoint(phi + e) - ellipsePoint(phi - e)).Unit
			local nrm = Vector2.new(-tan.Y, tan.X)
			local w = wMax * math.sin(math.pi * (s ^ p)) / 2
			left[#left + 1] = pt + nrm * w
			right[#right + 1] = pt - nrm * w
		end
		for i = #right, 1, -1 do left[#left + 1] = right[i] end
		return left
	end
	local function createLogo(parent, size, color, step)
		color = color or ORANGE
		step = step or 3
		local container = Instance.new("CanvasGroup")
		container.Name = "FoxyLogo"
		container.BackgroundTransparency = 1
		container.BorderSizePixel = 0
		container.Size = size
		container.Parent = parent
		local ratio = Instance.new("UIAspectRatioConstraint")
		ratio.AspectRatio = LW / LH
		ratio.Parent = container
		fillPoly(container, bandPoly(-85, 85, 38, 0.44, 40), color, step, LW, LH)
		fillPoly(container, bandPoly(95, 265, 36, 0.38, 40), color, step, LW, LH)
		fillPoly(container, starPoly(292, 248, 203, 170, 125, 110, 22, 20, 24), color, step, LW, LH)
		fillPoly(container, starPoly(206, 121, 26, 26, 24, 25, 4.5, 4.5, 12), color, step, LW, LH)
		fillPoly(container, starPoly(365, 361, 21, 21, 20, 21, 3.8, 3.8, 12), color, step, LW, LH)
		return container
	end

	-- ============================================================
