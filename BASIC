			local folder = new("Folder", { Name = "Explosion" }, getKillFxFolder())
			local c1, c2 = m.s["Color 1"], m.s["Color 2"]
			local baseColor = c1:Lerp(c2, 0.5)
			local radius = m.s.Radius
			local dur = m.s.Duration
			local thickness = m.s.Thickness
			local rings = {}
			for i = 1, 4 do
