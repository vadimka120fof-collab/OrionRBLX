					or currentTab == "Player" or currentTab == "Util" or currentTab == "Teleport")
				local tabChanged = (lastTab ~= currentTab)
				lastTab = currentTab

				newScroll.Visible = pageIsModules or q ~= ""

				local n = 0
				for _, m in ipairs(modules) do
					if m.card and m.card.Parent then
						local show
						if q ~= "" then
							show = string.find(string.lower(m.name), q, 1, true) ~= nil
