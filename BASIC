			if btCfg.neon then
				table.insert(beams, makeBeam(part, a0, a1, color, btCfg.width * btCfg.glow, math.clamp(btCfg.transparency + 0.65, 0, 1), 1))
				table.insert(beams, makeBeam(part, a0, a1, color, btCfg.width, btCfg.transparency, 1))
				table.insert(beams, makeBeam(part, a0, a1, color:Lerp(Color3.new(1, 1, 1), 0.7), btCfg.width * 0.35, btCfg.transparency, 1))
			else
				table.insert(beams, makeBeam(part, a0, a1, color, btCfg.width, btCfg.transparency, 0))
			end
			local info = TweenInfo.new(btCfg.lifetime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			for _, b in ipairs(beams) do
				TweenService:Create(b, info, { Width0 = 0, Width1 = 0 }):Play()
			end
			Debris:AddItem(part, btCfg.lifetime + 0.1)
		end
		local lastShot = 0
		local function tryShoot(ignoreAmmo, cooldown)
			if not btCfg.enabled then return end
			local now = os.clock()
			if now - lastShot < (cooldown or btCfg.shotDebounce) then return end
			local tool = getTool()
			if not tool then return end
			if isReloading(tool, ignoreAmmo) then return end
			lastShot = now
			spawnTrail(getMuzzlePos(tool), getTargetPos())
		end
		local watchConns = {}
		local watchedTool = nil
		local hasSignal = false
		local watchStart = 0
		local BAD_SOUND = { "reload", "equip", "unequip", "empty", "click", "draw", "holster", "hit", "impact", "shell" }
		local function badSound(name)
			name = name:lower()
			for _, w in ipairs(BAD_SOUND) do
				if name:find(w, 1, true) then return true end
			end
			return false
		end
		local function clearWatch()
			for _, c in ipairs(watchConns) do c:Disconnect() end
			table.clear(watchConns)
			hasSignal = false
		end
		local function watchTool(tool)
			clearWatch()
			watchedTool = tool
			watchStart = os.clock()
			local useAmmo = btCfg.mode == "Auto" or btCfg.mode == "Ammo"
			local useSound = btCfg.mode == "Auto" or btCfg.mode == "Sound"
			local function add(c) table.insert(watchConns, c) end
			if useAmmo then
				for _, name in ipairs(AMMO_NAMES) do
					local v = tool:FindFirstChild(name, true)
					if v and (v:IsA("IntValue") or v:IsA("NumberValue")) then
						local last = v.Value
						add(v.Changed:Connect(function(n)
							if n < last then tryShoot(true) end
							last = n
						end))
						hasSignal = true
					end
					local a = tool:GetAttribute(name)
					if typeof(a) == "number" then
						local last = a
						add(tool:GetAttributeChangedSignal(name):Connect(function()
							local n = tool:GetAttribute(name)
							if typeof(n) == "number" then
								if n < last then tryShoot(true) end
								last = n
							end
						end))
						hasSignal = true
					end
				end
			end
			if useSound then
				local function hookSound(s)
					if not s:IsA("Sound") or badSound(s.Name) then return end
					add(s.Played:Connect(function() tryShoot(true) end))
					add(s:GetPropertyChangedSignal("Playing"):Connect(function()
						if s.Playing then tryShoot(true) end
					end))
					hasSignal = true
				end
				for _, d in ipairs(tool:GetDescendants()) do hookSound(d) end
				add(tool.DescendantAdded:Connect(function(d)
					if d:IsA("Sound") and not badSound(d.Name) and os.clock() - watchStart > 0.4 then
						task.defer(tryShoot, true)
					end
				end))
			end
		end
