		local m = byName["Combat/Trigger Bot"]
		local triggerHold = _G.__orionTriggerHold
		if not (m and m.on) then
			if triggerPressed then triggerPressed = false if triggerHold then triggerHold(false) end end
			return
		end
		if _G.__orionMenuOpen then return end
		local cam = Workspace.CurrentCamera
		if not cam then return end
		local target = nil
		if m.s["Use Silent Target"] and sharedSilentTarget and sharedSilentTarget.Parent then
			local pl = Players:GetPlayerFromCharacter(sharedSilentTarget:FindFirstAncestorOfClass("Model"))
			if pl and not (m.s["Team Check"] and pl.Team == LocalPlayer.Team) and not teamIgnored(pl) then
				if not (m.s["Force Field Check"] and hasForceField(pl)) then target = pl end
			end
		end
		if not target then
			local mousePos = UIS:GetMouseLocation()
			local ray = cam:ViewportPointToRay(mousePos.X, mousePos.Y)
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { char(), cam }
			params.RespectCanCollide = true
			local r = Workspace:Raycast(ray.Origin, ray.Direction * m.s["Max Distance"], params)
			if r then
				local ch = r.Instance:FindFirstAncestorOfClass("Model")
				local h = ch and ch:FindFirstChildOfClass("Humanoid")
				local pl = ch and Players:GetPlayerFromCharacter(ch)
				if h and h.Health > 0 and pl and pl ~= LocalPlayer then
					if not (m.s["Team Check"] and pl.Team == LocalPlayer.Team) and not teamIgnored(pl) then
						if not (m.s["Force Field Check"] and hasForceField(pl)) then target = pl end
					end
				end
			end
		end
		if target then
			if m.s.Hold then
				if not triggerPressed then triggerPressed = true if triggerHold then triggerHold(true) end end
			else
				if not triggerPressed then
					triggerPressed = true
					if triggerHold then triggerHold(true) end
